# ── گشتی ─────────────────────────────
NODE_ENV=development
PORT=4000

# ── PostgreSQL ──────────────────────
DATABASE_URL=postgresql://arena:arena_secret_2026@localhost:5432/arena_db

# ── Redis ────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ──────────────────────────────
# پێویستە بۆ هەر پرۆژێک جیاواز بێت (کەمترین ١٦ پیت)
JWT_SECRET=dev_secret_change_me_please_1234
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_DAYS=30

# ── CORS ─────────────────────────────
# لایستەی origin ڕێگادراو — بە کۆما جیاواز بکرێن
CORS_ORIGINS=http://localhost:5173,https://arena.com,http://arena.com,https://www.arena.com

# ── پشتەوە (دوای proxy/nginx) ─────────
TRUST_PROXY=false
